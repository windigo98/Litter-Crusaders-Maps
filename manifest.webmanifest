{
  "name": "Litter Crusaders Maps: Catch 'em all, clean 'em all!",
  "short_name": "Litter Crusaders",
  "description": "A catch-'em-all litter cleanup game for kids and families.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2fbff",
